{
  "kind": "collectionType",
  "collectionName": "bookings",
  "info": {
    "singularName": "booking",
    "pluralName": "bookings",
    "displayName": "Booking"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "phone": {
      "type": "string"
    },
    "room": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::room.room"
    },
    "check_in": {
      "type": "date"
    },
    "check_out": {
      "type": "date"
    },
    "total": {
      "type": "integer"
    },
    "booking_status": {
      "type": "enumeration",
      "default": "Pending",
      "enum": [
        "Pending",
        "Approved",
        "Rejected",
        "Cancelled",
        "Completed"
      ]
    },
    "payment_method": {
      "type": "enumeration",
      "enum": [
        "bank_transfer",
        "cash"
      ]
    },
    "payment_bank": {
      "type": "enumeration",
      "enum": [
        "telebirr",
        "cbe",
        "cbebirr",
        "boa",
        "awash",
        "dashen",
        "mpesa",
        "siinqee",
        "kaafiebirr",
        "coopayebirr"
      ]
    },
    "payment_reference": {
      "type": "string"
    },
    "payment_status": {
      "type": "enumeration",
      "default": "unverified",
      "enum": [
        "unverified",
        "verifying",
        "verified",
        "failed",
        "pending_manual_review",
        "refunded"
      ]
    },
    "verify_request_id": {
      "type": "string"
    },
    "verified_at": {
      "type": "datetime"
    },
    "payment_receipt": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
